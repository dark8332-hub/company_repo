[Unit]
Description=openstack-exporter with go
Requires=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/openstack-exporter --os-client-config /etc/openstack/clouds.yml --web.listen-address=":9280" contrabass 
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
