listen_tcp = 1
tcp_port = "16509"
listen_addr = "0.0.0.0"
unix_sock_group = "libvirt"
unix_sock_ro_perms = "0777"
unix_sock_rw_perms = "0770"
auth_unix_ro = "none"
auth_unix_rw = "none"
auth_tcp = "none"
{% if enable_live_migration_tls %}
listen_tls = 1
key_file = "/etc/pki/libvirt/server-key.pem"
cert_file = "/etc/pki/libvirt/server-cert.pem"
ca_file = "/etc/pki/CA/cacert.pem"
{% else %}
listen_tls = 0
{% endif %}
