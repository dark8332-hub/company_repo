[DEFAULT]
log_dir = /var/log/nova
lock_path = /var/lock/nova
state_path = /var/lib/nova
my_ip = {{ hostvars[inventory_hostname]['ansible_'~int_api_interface]['ipv4']['address'] }}
transport_url = rabbit://{% for host in groups['controller'] %}{{ rabbitmq_name }}:{{ rabbitmq_password }}@{{ hostvars[host]['ansible_'~int_api_interface]['ipv4']['address'] }}:{{ rabbitmq_amqp_port }}{% if not loop.last %},{% endif %}{% endfor %}

{% if internal_endpoint_protocol == "https"  %}
certfile = {{ internal_fqdn_cert }}
keyfile = {{ internal_fqdn_cert }}
{% endif %}
use_neutron = True
firewall_driver = nova.virt.firewall.NoopFirewallDriver
allow_resize_to_same_host = true
resize_confirm_window = 1
cpu_allocation_ratio = {{ cpu_allocation_ratio | default(1.0) }}
ram_allocation_ratio = 1.0

rpc_backend = rabbit
block_device_allocate_retries = 600
block_device_allocate_retries_interval = 3
vif_plugging_timeout = 1800
vif_plugging_is_fatal = false

[api_database]
connection = mysql+pymysql://nova:{{ db_password }}@{{ internal_vip_address }}:{{ percona_bind_port }}/nova_api
[database]
connection = mysql+pymysql://nova:{{ db_password }}@{{ internal_vip_address }}:{{ percona_bind_port }}/nova


[api]
auth_strategy = keystone

[cache]
enabled = true
backend = oslo_cache.memcache_pool
memcached_servers = {% for host in groups['controller'] %}{{ hostvars[host]['ansible_'~int_api_interface]['ipv4']['address'] }}:11211{% if not loop.last %},{% endif %}{% endfor %}

[keystone_authtoken]
service_token_roles = service
service_token_required = true
www_authenticate_uri = {{ internal_endpoint_protocol }}://{{ internal_endpoint }}:{{ keystone_bind_port }}
auth_url = {{ internal_endpoint_protocol }}://{{ internal_endpoint }}:{{ keystone_bind_port }}
{% if internal_endpoint_protocol == "https"  %}
certfile = {{ internal_fqdn_cert }}
keyfile = {{ internal_fqdn_cert }}
{% endif %}
auth_type = password
project_domain_name = Default
user_domain_name = Default
project_name = service
username = nova
password = {{ keystone_pass }}
memcached_servers = {% for host in groups['controller'] %}{{ hostvars[host]['ansible_'~int_api_interface]['ipv4']['address'] }}:11211{% if not loop.last %},{% endif %}{% endfor %}

[cells]
enable=False

[oslo_concurrency]
lock_path= /var/lib/nova/tmp

[wsgi]
api_paste_config=/etc/nova/api-paste.ini

[vnc]
enabled = True
server_listen = $my_ip
server_proxyclient_address = $my_ip
novncproxy_host = 0.0.0.0
novncproxy_base_url = {{ internal_endpoint_protocol }}://{{ public_endpoint }}:16080/vnc_auto.html

[oslo_messaging_rabbit]
amqp_auto_delete = False
kombu_reconnect_delay = 3.0
rabbit_retry_backoff = 2
rabbit_retry_interval = 1
rpc_conn_pool_size = 100
kombu_missing_consumer_retry_timeout = 30
heartbeat_timeout_threshold = 30
enable_cancel_on_failover = true
heartbeat_rate = 2
kombu_failover_strategy = shuffle
{% if enable_tls_rabbitmq %}
ssl = true
ssl_key_file = {{ certfile_dest }}
ssl_cert_file = {{ keyfile_dest }}
ssl_ca_file = {{ cacertfile_dest }}
{% endif %}

[oslo_messaging_notifications]
driver = messagingv2
topics = notifications

[glance]
api_servers = {{ internal_endpoint_protocol }}://{{ internal_endpoint }}:{{ glance_bind_port }}
{% if internal_endpoint_protocol == "https"  %}
certfile = {{ internal_fqdn_cert }}
keyfile = {{ internal_fqdn_cert }}
{% endif %}

[cinder]
catalog_info = volumev3:cinder:internalURL	
os_region_name = RegionOne
endpoint_type = internal
{% if internal_endpoint_protocol == "https"  %}
certfile = {{ internal_fqdn_cert }}
keyfile = {{ internal_fqdn_cert }}
{% endif %}

[placement]
os_region_name = RegionOne
project_domain_name = Default
project_name = service
auth_type = password
user_domain_name = Default
auth_url = {{ internal_endpoint_protocol }}://{{ internal_endpoint }}:{{ keystone_bind_port }}/v3
{% if internal_endpoint_protocol == "https"  %}
certfile = {{ internal_fqdn_cert }}
keyfile = {{ internal_fqdn_cert }}
{% endif %}
username = placement
password = {{ keystone_pass }} 
endpoint_type = internal

[neutron]
auth_url = {{ internal_endpoint_protocol }}://{{ internal_endpoint }}:{{ keystone_bind_port }}/v3
{% if internal_endpoint_protocol == "https"  %}
certfile = {{ internal_fqdn_cert }}
keyfile = {{ internal_fqdn_cert }}
{% endif %}
auth_type = password
project_domain_name = default
user_domain_name = default
region_name = RegionOne
project_name = service
username = neutron
password = {{ keystone_pass }}
service_metadata_proxy = true
metadata_proxy_shared_secret = {{ keystone_pass }}

[libvirt]
virt_type=kvm
live_migration_completion_timeout = 300
live_migration_downtime = 100
live_migration_downtime_steps = 3
live_miogration_downtime_delay = 3
live_migration_permit_auto_converge = true
{% if enable_openstack_tls %}
live_migration_with_native_tls = true
live_migration_scheme = tls
live_migration_flag="VIR_MIGRATE_UNDEFINE_SOURCE, VIR_MIGRATE_PEER2PEER,VIR_MIGRATE_PERSIST_DEST,VIR_MIGRATE_TUNNELLED"
live_migration_uri = qemu+tls://%s/system
{% else %}
live_migration_uri = qemu+tcp://%s/system
{% endif %}

[compute]
live_migration_wait_for_vif_plug = true

[service_user]
send_service_user_token = true
auth_url = {{ internal_endpoint_protocol }}://{{ internal_endpoint }}:{{ keystone_bind_port }}
{% if internal_endpoint_protocol == "https" == true %}
certfile = {{ internal_fqdn_cert }}
keyfile = {{ internal_fqdn_cert }}
{% endif %}
auth_strategy = keystone
auth_type = password
project_domain_name = Default
project_name = service
user_domain_name = Default
username = nova
password = {{ keystone_pass }} 

{% if openstack_version == 'caracal' %}
[workarounds]
skip_cpu_compare_at_startup = true
skip_cpu_compare_on_dest = true
{% endif %}
