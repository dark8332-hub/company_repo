#!/bin/bash
set -ex

# OpenStack CLI 환경
source /root/contrabass-openrc

# === 사용자/환경 변수 (필요 시 수정) ==========================
# 포트 "이름"만 알면 자동으로 IP/Prefix를 가져와 세팅합니다.
OCTAVIA_HEALTH_MANAGER_PORT_NAME={{ octavia_health_manager_port_name }}

# MTU는 네트워크에서 조회되면 그 값을 쓰고, 조회 실패 시 아래 기본값 사용
DEFAULT_MTU=1450
# ============================================================

# Neutron 포트 정보
MGMT_PORT_ID=$(openstack port show -f value -c id "$OCTAVIA_HEALTH_MANAGER_PORT_NAME")
MGMT_PORT_MAC=$(openstack port show -f value -c mac_address "$MGMT_PORT_ID")
FIXED_IPS_RAW=$(openstack port show -f value -c fixed_ips "$MGMT_PORT_ID")

# fixed_ips 파싱 (ip_address & subnet_id)
IP_ADDR=$(echo "$FIXED_IPS_RAW" | \
  grep -oE "ip_address['\"]?[:=][ ']*([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)" | \
  grep -oE "([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)" | head -n1)

SUBNET_ID=$(echo "$FIXED_IPS_RAW" | \
  grep -oE "subnet_id['\"]?[:=][ ']*[a-f0-9-]{36}" | \
  grep -oE "[a-f0-9-]{36}" | head -n1)

# prefixlen 구하기
CIDR=$(openstack subnet show -f value -c cidr "$SUBNET_ID")
PREFIXLEN=$(echo "$CIDR" | awk -F/ '{print $2}')

# 네트워크 MTU 조회 (없으면 DEFAULT_MTU 사용)
NET_ID=$(openstack port show -f value -c network_id "$MGMT_PORT_ID")
NET_MTU=$(openstack network show -f value -c mtu "$NET_ID" 2>/dev/null || true)
MTU_TO_SET=${NET_MTU:-$DEFAULT_MTU}

if [ -z "$IP_ADDR" ] || [ -z "$PREFIXLEN" ]; then
  echo "ERROR: Unable to determine IP/prefix from Neutron port $MGMT_PORT_ID"
  exit 1
fi

case "$1" in
  start)
    # OVS 내부 포트 생성 및 속성 설정 (외부 ID 키 정확히 'external_ids:*')
    sudo ovs-vsctl -- --may-exist add-port br-int o-hm0 \
      -- set Interface o-hm0 type=internal \
      -- set Interface o-hm0 external_ids:iface-status=active \
      -- set Interface o-hm0 external_ids:attached-mac="$MGMT_PORT_MAC" \
      -- set Interface o-hm0 external_ids:iface-id="$MGMT_PORT_ID"

    ip link set dev o-hm0 address "$MGMT_PORT_MAC"
    ip link set dev o-hm0 mtu "$MTU_TO_SET"
    ip link set o-hm0 up

    # IP를 '고정'으로 설정 (이전 주소 있으면 정리)
    ip addr flush dev o-hm0 && sleep 1
    ip addr add "$IP_ADDR/$PREFIXLEN" dev o-hm0

    # Amphora 관리망으로 기본 경로가 생기지 않도록 정리
    ip route del default via 172.16.0.1 dev o-hm0 2>/dev/null || true
    ;;

  stop)
    # IP/라우트 정리 후 포트 제거
    ip addr flush dev o-hm0 || true
    sudo ovs-vsctl del-port o-hm0 || true
    ;;

  *)
    # 상태 확인
    ovs-vsctl list-ports br-int || true
    ovs-vsctl list interface o-hm0 || true
    ip -br a s dev o-hm0 || true
    ip route show dev o-hm0 || true
    ;;
esac
