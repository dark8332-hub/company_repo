[Unit]
Description=masakari host monitor service

[Service]
Restart=always
User=root
Group=root
ExecStart=/usr/local/bin/masakari-hostmonitor --config-file=/etc/masakarimonitors/masakarimonitors.conf --log-file=/var/log/masakarimonitors/masakari-host-monitor.log
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStopSec=15
LimitNOFILE=65535
Restart=on-failure

[Install]
WantedBy=multi-user.target
