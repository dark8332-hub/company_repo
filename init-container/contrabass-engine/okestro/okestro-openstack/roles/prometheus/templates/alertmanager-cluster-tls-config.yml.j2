tls_server_config:
  cert_file: {{ monitoring_certs_dir }}/monitoring-server.crt
  key_file: {{ monitoring_certs_dir }}/monitoring-server.key
  client_auth_type: VerifyClientCertIfGiven
  client_ca_file: {{ monitoring_certs_dir }}/monitoring-ca.crt

tls_client_config:
  cert_file: {{ monitoring_certs_dir }}/monitoring-server.crt
  key_file: {{ monitoring_certs_dir }}/monitoring-server.key
  ca_file: {{ monitoring_certs_dir }}/monitoring-ca.crt
  insecure_skip_verify: false
