global:
  scrape_interval: 30s
  evaluation_interval: 30s
  scrape_timeout: 20s
{% if monitoring_ha_enable %}
  external_labels:
    prometheus: monitoring-cluster
    prometheus_replica: prometheus-{{ hostvars[inventory_hostname]['ansible_hostname'] }}
{% endif %}

alerting:
{% if monitoring_ha_enable %}
  alert_relabel_configs:
    - regex: prometheus_replica
      action: labeldrop
{% endif %}

  alertmanagers:
{% if monitoring_enable_tls %}
    - scheme: https
      tls_config:
        cert_file: {{ monitoring_certs_dir }}/monitoring-server.crt
        key_file: {{ monitoring_certs_dir }}/monitoring-server.key
        ca_file: {{ monitoring_certs_dir }}/monitoring-ca.crt
        insecure_skip_verify: false
{% else %}
    - scheme: http
{% endif %}
      static_configs:
        - targets:
{% for item in groups['controller'] %}
          - "{{ hostvars[item]['ansible_'~monitoring_network_interface]['ipv4']['address'] }}:{{ alertmanager_web_port }}"
{% endfor %}

rule_files:
  - "./rules/*.yml"

scrape_configs:
- job_name: "prometheus"
  scrape_interval: 60s
  metrics_path: /metrics
{% if monitoring_enable_tls %}
  scheme: https
  tls_config:
    cert_file: {{ monitoring_certs_dir }}/monitoring-server.crt
    key_file: {{ monitoring_certs_dir }}/monitoring-server.key
    ca_file: {{ monitoring_certs_dir }}/monitoring-ca.crt
    insecure_skip_verify: false
{% else %}
  scheme: http
{% endif %}
  metric_relabel_configs:
    - source_labels: [__name__]
      regex: '^(?:up|prometheus_config_last_reload_successful|prometheus_rule_evaluation_failures_total|prometheus_target_scrapes_exceeded_sample_limit_total|prometheus_tsdb_head_series|prometheus_notifications_errors_total|process_resident_memory_bytes|process_cpu_seconds_total|go_goroutines)$'
      action: keep
  static_configs:
    - targets:
{% for item in groups['controller'] %}
      - "{{ hostvars[item]['ansible_'~monitoring_network_interface]['ipv4']['address'] }}:{{ prometheus_port }}"
{% endfor %}

- job_name: "alertmanager"
  scrape_interval: 60s
  metrics_path: /metrics
{% if monitoring_enable_tls %}
  scheme: https
  tls_config:
    cert_file: {{ monitoring_certs_dir }}/monitoring-server.crt
    key_file: {{ monitoring_certs_dir }}/monitoring-server.key
    ca_file: {{ monitoring_certs_dir }}/monitoring-ca.crt
    insecure_skip_verify: false
{% else %}
  scheme: http
{% endif %}
  metric_relabel_configs:
    - source_labels: [__name__]
      regex: '^(?:alertmanager_alerts_invalid_total|alertmanager_cluster_members|alertmanager_notifications_failed_total|alertmanager_notifications_total)$'
      action: keep
  static_configs:
    - targets:
{% for item in groups['controller'] %}
      - "{{ hostvars[item]['ansible_'~monitoring_network_interface]['ipv4']['address'] }}:{{ alertmanager_web_port }}"
{% endfor %}

- job_name: "node_exporter"
  metrics_path: /metrics
{% if monitoring_enable_tls %}
  scheme: https
  tls_config:
    cert_file: {{ monitoring_certs_dir }}/monitoring-server.crt
    key_file: {{ monitoring_certs_dir }}/monitoring-server.key
    ca_file: {{ monitoring_certs_dir }}/monitoring-ca.crt
    insecure_skip_verify: false
{% else %}
  scheme: http
{% endif %}
  metric_relabel_configs:
    - source_labels: [__name__]
      regex: '^(?:contrabass_gpu_info|contrabass_mig_profile_info|contrabass_vgpu_vm_info|node_boot_time_seconds|node_context_switches_total|node_cpu_seconds_total|node_disk_io_now|node_disk_io_time_seconds_total|node_disk_read_bytes_total|node_disk_read_time_seconds_total|node_disk_reads_completed_total|node_disk_write_time_seconds_total|node_disk_writes_completed_total|node_disk_written_bytes_total|node_fibrechannel_info|node_filefd_allocated|node_filefd_maximum|node_filesystem_avail_bytes|node_filesystem_files|node_filesystem_files_free|node_filesystem_free_bytes|node_filesystem_size_bytes|node_load1|node_load15|node_load5|node_memory_Buffers_bytes|node_memory_Cached_bytes|node_memory_MemAvailable_bytes|node_memory_MemFree_bytes|node_memory_MemTotal_bytes|node_memory_SReclaimable_bytes|node_memory_SwapFree_bytes|node_memory_SwapTotal_bytes|node_netstat_TcpExt_ListenDrops|node_netstat_Tcp_ActiveOpens|node_netstat_Tcp_CurrEstab|node_netstat_Tcp_InSegs|node_netstat_Tcp_OutSegs|node_netstat_Tcp_PassiveOpens|node_netstat_Tcp_RetransSegs|node_network_info|node_network_receive_bytes_total|node_network_receive_errs_total|node_network_receive_packets_total|node_network_speed_bytes|node_network_transmit_bytes_total|node_network_transmit_errs_total|node_network_transmit_packets_total|node_network_up|node_pressure_memory_waiting_seconds_total|node_schedstat_waiting_seconds_total|node_sockstat_TCP_alloc|node_sockstat_TCP_tw|node_sockstat_UDP_inuse|node_sockstat_sockets_used|node_systemd_unit_state|node_uname_info|node_vmstat_pgmajfault|node_vmstat_pswpin|node_vmstat_pswpout|up|node_network_mtu_bytes|node_network_receive_drop_total|node_network_transmit_drop_total|node_bonding_slaves|node_bonding_active)$'
      action: keep
    - source_labels:
        - __name__
        - state
      separator: ';'
      regex: 'node_systemd_unit_state;(activating|deactivating|inactive)'
      action: drop
    - source_labels:
        - __name__
        - type
      separator: ';'
      regex: 'node_systemd_unit_state;oneshot'
      action: drop
  file_sd_configs:
  - files:
    - "./sd_files/node-exporter.yaml"

- job_name: "contrabass_exporter"
  metrics_path: /metrics
  scheme: http
  metric_relabel_configs:
    - source_labels: [__name__]
      regex: '^(?:libvirt_domain_block_stats_capacity_bytes|libvirt_domain_block_stats_read_bytes_total|libvirt_domain_block_stats_read_requests_total|libvirt_domain_block_stats_write_bytes_total|libvirt_domain_block_stats_write_requests_total|libvirt_domain_info_cpu_iowait_seconds_total|libvirt_domain_info_cpu_steal_seconds_total|libvirt_domain_info_cpu_time_seconds_total|libvirt_domain_info_maximum_memory_bytes|libvirt_domain_info_memory_usage_bytes|libvirt_domain_info_state|libvirt_domain_info_virtual_cpus|libvirt_domain_interface_stats_receive_bytes_total|libvirt_domain_interface_stats_receive_drops_total|libvirt_domain_interface_stats_receive_errors_total|libvirt_domain_interface_stats_receive_packets_total|libvirt_domain_interface_stats_transmit_bytes_total|libvirt_domain_interface_stats_transmit_drops_total|libvirt_domain_interface_stats_transmit_errors_total|libvirt_domain_interface_stats_transmit_packets_total|libvirt_domain_memory_stats_available_bytes|libvirt_domain_memory_stats_major_fault_total|libvirt_domain_memory_stats_swap_in_bytes|libvirt_domain_memory_stats_swap_out_bytes|libvirt_domain_memory_stats_usable_bytes|libvirt_domain_memory_stats_used_percent|libvirt_domain_openstack_info|libvirt_domain_stat_memory_available_bytes|libvirt_domain_stat_memory_usable_bytes|libvirt_domain_stat_swap_free_bytes|libvirt_domain_stat_swap_total_bytes|libvirt_domain_vcpu_delay_seconds_total|libvirt_up)$'
      action: keep
  file_sd_configs:
  - files:
    - "./sd_files/contrabass-exporter.yaml"

