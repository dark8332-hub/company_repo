[Unit]
Description=Thnaos Store
Wants=network-online.target
After=network-online.target

[Service]
User=root
Group=root
Restart=on-failure
Type=simple
ExecStart={{ exe_path }}/thanos store \
    --grpc-address=0.0.0.0:{{ thanos_store_grpc_port }} \
{% if monitoring_enable_tls %}
    --grpc-server-tls-cert={{ monitoring_certs_dir }}/monitoring-server.crt \
    --grpc-server-tls-key={{ monitoring_certs_dir }}/monitoring-server.key \
    --grpc-server-tls-client-ca={{ monitoring_certs_dir }}/monitoring-ca.crt \
{% endif %}
    --http-address=0.0.0.0:{{ thanos_store_http_port }} \
{% if monitoring_enable_tls %}
    --http.config={{ thanos_config_dir }}/config/thanos-http-server-config.yml \
{% endif %}
    --data-dir={{ thanos_store_data_dir }} \
    --objstore.config-file={{ thanos_config_dir }}/buckets/thanos-bucket.yml

[Install]
WantedBy=multi-user.target
