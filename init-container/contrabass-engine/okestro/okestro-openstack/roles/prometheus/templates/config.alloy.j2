{% if cinder_backend == "ceph" and 'osds' in group_names %}
discovery.relabel "ceph_osd" {
  targets = []

  rule {
    target_label = "job"
    replacement  = "ceph"
  }

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "ceph-.*@osd\\..*\\.service"
    action        = "keep"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "ceph-.*@osd\\.(\\d+)\\.service"
    target_label  = "osd_id"
    replacement   = "$1"
  }

  rule {
    target_label = "ceph_daemon"
    replacement  = "osd"
  }
}

loki.source.journal "ceph_osd" {
  max_age       = "12h0m0s"
  path          = "/var/log/journal"
  relabel_rules = discovery.relabel.ceph_osd.rules
  forward_to    = [loki.write.default.receiver]
  labels        = {}
}
{% endif %}

