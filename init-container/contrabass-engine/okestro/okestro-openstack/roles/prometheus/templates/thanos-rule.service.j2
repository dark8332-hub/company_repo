[Unit]
Description=Thanos Rule
Wants=network-online.target
After=network-online.target

[Service]
User=root
Group=root
Restart=on-failure
Type=simple
ExecStart={{ exe_path }}/thanos rule \
    --grpc-address=0.0.0.0:{{ thanos_rule_grpc_port }} \
{% if monitoring_enable_tls %}
    --grpc-server-tls-cert={{ monitoring_certs_dir }}/monitoring-server.crt \
    --grpc-server-tls-key={{ monitoring_certs_dir }}/monitoring-server.key \
    --grpc-server-tls-client-ca={{ monitoring_certs_dir }}/monitoring-ca.crt \
{% endif %}
    --http-address=0.0.0.0:{{ thanos_rule_http_port }} \
{% if monitoring_enable_tls %}
    --http.config={{ thanos_config_dir }}/config/thanos-http-server-config.yml \
{% endif %}
    --alertmanagers.config-file={{ thanos_config_dir }}/config/thanos-rule-alertmanager-http-client-config.yml \
    --query.config-file={{ thanos_config_dir }}/config/thanos-rule-query-http-client-config.yml \
    --alert.label-drop=prometheus_replica \
    --data-dir={{ thanos_rule_data_dir }} \
    --objstore.config-file={{ thanos_config_dir }}/buckets/thanos-bucket.yml \
    --eval-interval=1m \
    --rule-file={{ thanos_config_dir }}/rules/*.yml \
    --label='prometheus="monitoring-cluster"' \
    --label='prometheus_replica="thanos-rule-{{ hostvars[inventory_hostname]['ansible_hostname'] }}"'

[Install]
WantedBy=multi-user.target
