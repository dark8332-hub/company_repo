service_type: container
# 이 서비스 인스턴스의 고유 식별자. (보통 service_name 뒤에 붙어 식별됨)
service_id: anomaly-predictor
# 서비스의 그룹명입니다. ceph orch ls 명령 조회 시 표시되는 이름.
service_name: anomaly-predictor
# 컨테이너가 배포될 위치를 정의
placement:
  # 라벨 기반으로 배포 가능 (ceph orch host label add ceph0 anomaly_node)
  # label: anomaly_node
  # ceph0 ~ ceph7까지 지정된 호스트에 배포.
  hosts:
{% for host in groups['mons'] %}
    - {{ host }}
{% endfor %}
# 컨테이너 실행에 필요한 구체적인 명세.
spec:
  image: private-registry.local:6666/ceph-services/anomaly-predictor:v1.7.7
  # 컨테이너 내부에 주입될 환경 변수.
  envs:
    - PORT=9083
    # go-ceph 라이브러리가 클러스터 연결 정보를 찾기 위한 경로.
    - CEPH_CONF=/etc/ceph/ceph.conf
    - CEPH_KEYRING=/etc/ceph/ceph.client.admin.keyring
    - TZ=Asia/Seoul
  # docker run (또는 podman run) 실행 시 추가할 인자들.
  extra_container_args:
    # 호스트 네트워크를 그대로 사용. (포트 포워딩 없이 호스트 IP:9083으로 바로 접근 가능)
    - "--network=host"
    # 호스트의 파일/디렉토리를 컨테이너에 마운트합니다. (Ceph 설정 파일 및 타임존 동기화 목적)
    - "--volume"
    - "/etc/ceph:/etc/ceph:ro"
    - "--volume"
    - "/var/lib/ceph:/var/lib/ceph:ro"
    - "--volume"
    - "/etc/localtime:/etc/localtime:ro"
