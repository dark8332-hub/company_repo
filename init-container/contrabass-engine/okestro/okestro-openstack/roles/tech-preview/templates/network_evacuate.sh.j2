#!/bin/bash

DB_USER="root"
DB_PASS="{{ db_password }}"  # 여기에 root 비밀번호 입력
DB_NAME="evacuation"
TABLE="vmservice_network"

# MySQL 명령어 실행 함수
run_mysql() {
    mysql -u"$DB_USER" -p"$DB_PASS" -D"$DB_NAME" -e "$1"
}

# Prometheus API 설정
PROMETHEUS_URL="{% if monitoring_enable_tls %}https{% else %}http{% endif %}://{{ internal_vip_address }}:{{ thanos_bind_port }}"
QUERY="node_network_up%7Bjob%3D%22node_exporter%22%2C%20device%3D%22{{ vm_service_interface }}%22%7D%20%3D%3D%200"
#QUERY="node_network_up{job="node_exporter", device="{{ vm_service_interface }}"} == 0"


# 다운 호스트 찾기 (Prometheus 쿼리)
echo "서비스 네트워크 다운 호스트를 Prometheus에서 조회 중..."
RESPONSE=$(curl -s -k "${PROMETHEUS_URL}/api/v1/query?query=${QUERY}")
if [ $? -ne 0 ]; then
    echo "오류: Prometheus API 호출 실패. URL 또는 네트워크 확인 필요."
fi

# JSON에서 hostname 추출 (grep/sed로 처리, nodename 우선, instance fallback)
if echo "$RESPONSE" | grep -q '"result": \[\]'; then
    echo "오류: 서비스 네트워크 다운 호스트를 찾을 수 없습니다. Prometheus 쿼리 결과 없음."
fi

# nodename 값 추출 (우선 사용)
HOSTNAMES=$(echo "$RESPONSE" | grep -o '"nodename"[[:space:]]*:[[:space:]]*[^,}]*' | sed 's/"nodename"[[:space:]]*:[[:space:]]*//;s/"//g')
if [ -z "$HOSTNAMES" ]; then
    # instance 값 추출 (fallback으로 사용)
    HOSTNAMES=$(echo "$RESPONSE" | grep -o '"instance": "[^"]*"' | sed 's/"instance": "//;s/"//')
    if [ -z "$HOSTNAMES" ]; then
        echo "오류: 서비스 네트워크 다운 호스트를 찾을 수 없습니다. Prometheus 쿼리 결과 없음."
    fi
fi

echo "디버그: 추출된 HOSTNAMES: $HOSTNAMES"

# 다운 호스트들 처리
for HOSTNAME in $HOSTNAMES; do
    echo "처리 중인 호스트 (hostname): $HOSTNAME"

    # hostname에서 실제 호스트 이름 추출 (':' 앞부분 또는 이미 hostname일 경우)
    if [[ "$HOSTNAME" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+$ ]]; then
        # IP:포트 형식이면 ':' 앞부분 추출
        HOST_NAME=$(echo "$HOSTNAME" | cut -d':' -f1)
    else
        # 이미 hostname (예: com2)면 그대로 사용
        HOST_NAME="$HOSTNAME"
    fi
    echo "추출된 hostname: $HOST_NAME"

    if ping -c 5 -W 1 "$HOST_NAME" >/dev/null 2>&1 || curl -s --connect-timeout 2 -k "$HTTP_SEQ://$HOST_NAME:$NODE_EXP_PORT" > /dev/null 2>&1; then
        echo "경고: $HOST_NAME은 ping 또는 NodeExporter에 응답이 있어 호스트 다운이 아닐 수 있습니다. node-exporter만 다운일 가능성 있습니다."
        continue  # ping 응답이 있으면 건너뜁니다.
    else
        echo "확인: $HOST_NAME은 ping 응답이 없어 호스트 다운으로 판단됩니다."
    fi


    # 현재 maintance 값 확인 (테이블 열 이름 hostname 사용)
    MAINTANCE=$(run_mysql "SELECT maintance FROM $TABLE WHERE hostname='$HOST_NAME';" | tail -n 1)

    # 결과가 없으면 호스트가 테이블에 없는 경우
    if [ -z "$MAINTANCE" ]; then
        echo "오류: $HOST_NAME이 $TABLE 테이블에 존재하지 않습니다."
        echo "먼저 호스트를 테이블에 추가해주세요."
        continue
    fi

    echo "현재 $HOST_NAME의 maintance 값: $MAINTANCE"

    # maintance 값에 따라 처리
    if [ "$MAINTANCE" -eq 1 ]; then
        echo "$HOST_NAME의 maintance가 이미 1입니다. nova host-evacuate를 건너뜁니다."
    else
        # maintance를 1로 업데이트
        run_mysql "UPDATE $TABLE SET maintance=1 WHERE hostname='$HOST_NAME';"
        if [ $? -eq 0 ]; then
            echo "$HOST_NAME의 maintance를 1로 업데이트했습니다."

            # nova host-evacuate 실행 (실제 hostname으로)
            echo "nova host-evacuate 실행: $HOST_NAME"
            source /root/contrabass-openrc
            #openstack compute service set --down "$HOST_NAME" nova-compute
            ssh root@"$HOST_NAME" "systemctl stop nova-compute.service"
            sleep 120
            nova --os-compute-api-version 2.81 host-evacuate "$HOST_NAME"
            if [ $? -eq 0 ]; then
                echo "nova host-evacuate 성공: $HOST_NAME"
            else
                echo "nova host-evacuate 실패: $HOST_NAME"
            fi
        else
            echo "maintance 업데이트 실패: $HOST_NAME"
        fi
    fi

    # 최종 상태 확인
    echo -e "\n최종 $TABLE 테이블 상태 (현재 호스트):"
    run_mysql "SELECT * FROM $TABLE WHERE hostname='$HOST_NAME';"
done

echo "처리 완료!"
