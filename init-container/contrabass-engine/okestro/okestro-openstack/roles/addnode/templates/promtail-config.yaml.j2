server:
  http_listen_port: 9080
{% if monitoring_enable_tls %}
  http_tls_config:
    cert_file: /opt/monitoring-certs/monitoring-server.crt
    key_file: /opt/monitoring-certs/monitoring-server.key
{% endif %}

positions:
  filename: /tmp/positions.yaml

clients:
{% if monitoring_enable_tls %}
  - url: https://{{ monitoring_vip_address }}:{{ loki_bind_port }}/loki/api/v1/push
    tls_config:
      cert_file: /opt/monitoring-certs/monitoring-server.crt
      key_file: /opt/monitoring-certs/monitoring-server.key
      insecure_skip_verify: true
{% else %}
  - url: http://{{ monitoring_vip_address }}:{{ loki_bind_port }}/loki/api/v1/push
{% endif %}
    batchsize: 524288

scrape_configs:
- job_name: system
  static_configs:
  - targets:
    - localhost
    labels:
      job: syslog
{% if ansible_os_family == 'RedHat' %}
      __path__: /var/log/messages
{% else %}
      __path__: /var/log/syslog
{% endif %}
      hostname: "{{ inventory_hostname }}"
  - targets:
      - localhost
    labels:
      job: authlog
{% if ansible_os_family == 'RedHat' %}
      __path__: /var/log/audit/audit.log
{% else %}
      __path__: /var/log/auth.log
{% endif %}
      hostname: "{{ inventory_hostname }}"
{% if inventory_hostname in groups['controller'] %}

- job_name: middleware
  static_configs:
  - targets:
      - localhost
    labels:
      job: haproxylog
      __path__: /var/log/haproxy.log
      hostname: "{{ inventory_hostname }}"
  - targets:
      - localhost
    labels:
      job: pacemakerlog
      __path__: /var/log/pacemaker/pacemaker.log
      hostname: "{{ inventory_hostname }}"
  - targets:
      - localhost
    labels:
      job: corosynclog
      __path__: /var/log/corosync/corosync.log
      hostname: "{{ inventory_hostname }}"
  - targets:
      - localhost
    labels:
      job: pcsdlog
      __path__: /var/log/pcsd/pcsd.log
      hostname: "{{ inventory_hostname }}"
  - targets:
      - localhost
    labels:
      job: mysqllog
      __path__: /var/log/mysql/error.log
      hostname: "{{ inventory_hostname }}"
  - targets:
      - localhost
    labels:
      job: rabbitmqlog
      __path__: /var/log/rabbitmq/rabbit*.log
      hostname: "{{ inventory_hostname }}"
{% endif %}

- job_name: openstack
  static_configs:
  - targets:
      - localhost
    labels:
      job: novalog
      __path__: /var/log/nova/*.log
      hostname: "{{ inventory_hostname }}"
  - targets:
      - localhost
    labels:
      job: neutronlog
      __path__: /var/log/neutron/*.log
      hostname: "{{ inventory_hostname }}"
{% if inventory_hostname in groups['controller'] %}
  - targets:
      - localhost
    labels:
      job: keystonelog
      __path__: /var/log/keystone/*.log
      hostname: "{{ inventory_hostname }}"
  - targets:
      - localhost
    labels:
      job: keystone-httplog
{% if ansible_os_family == 'RedHat' %}
      __path__: /var/log/httpd/keystone*.log
{% else %}
      __path__: /var/log/apache2/keystone*.log
{% endif %}
      hostname: "{{ inventory_hostname }}"
  - targets:
      - localhost
    labels:
      job: glancelog
      __path__: /var/log/glance/*.log
      hostname: "{{ inventory_hostname }}"
  - targets:
      - localhost
    labels:
      job: placementlog
{% if ansible_os_family == 'RedHat' %}
      __path__: /var/log/httpd/placement*.log
{% else %}
      __path__: /var/log/apache2/placement*.log
{% endif %}
      hostname: "{{ inventory_hostname }}"
  - targets:
      - localhost
    labels:
      job: cinderlog
      __path__: /var/log/cinder/*.log
      hostname: "{{ inventory_hostname }}"
{% if ansible_facts['distribution'] == 'Ubuntu' %}
  - targets:
      - localhost
    labels:
      job: cinder-httplog
      __path__: /var/log/apache2/cinder*.log
      hostname: "{{ inventory_hostname }}"
{% endif %}
{% if enable_manila %}
  - targets:
      - localhost
    labels:
      job: manilalog
      __path__: /var/log/manila/*.log
      hostname: "{{ inventory_hostname }}"
{% endif %}
{% if enable_octavia %}
  - targets:
      - localhost
    labels:
      job: octavialog
      __path__: /var/log/octavia/*.log
      hostname: "{{ inventory_hostname }}"
{% endif %}
{% if enable_barbican %}
  - targets:
      - localhost
    labels:
      job: barbicanlog
      __path__: /var/log/barbican/*.log
      hostname: "{{ inventory_hostname }}"
{% endif %}
{% if enable_heat %}
  - targets:
      - localhost
    labels:
      job: heatlog
      __path__: /var/log/heat/*.log
      hostname: "{{ inventory_hostname }}"
{% endif %}
{% if enable_masakari %}
  - targets:
      - localhost
    labels:
      job: masakarilog
      __path__: /var/log/masakari/*.log
      hostname: "{{ inventory_hostname }}"
{% if ansible_facts['distribution'] == 'Ubuntu' %}
  - targets:
      - localhost
    labels:
      job: masakari-httplog
      __path__: /var/log/apache2/masakari_*.log
      hostname: "{{ inventory_hostname }}"
{% endif %}
{% endif %}
{% endif %}
