# OpenStack 운영 지원 플랫폼 - 배포 설정
#
# install.sh 가 이 파일을 config.env 로 복사합니다.
# 값을 고친 뒤에는 ./opsctl.sh restart 로 반영합니다.

# ---------------------------------------------------------------------------
# 접속
# ---------------------------------------------------------------------------

# 이미지 태그. 번들에 들어 있는 이미지 파일 이름과 맞아야 합니다. 보통 고칠 일이 없습니다.
IMAGE_TAG=__IMAGE_TAG__

# 웹 화면 포트. 이미 쓰는 포트면 다른 값으로 바꾸세요.
HOST_PORT=8090

# 어느 주소로 들어오는 접속을 받을지.
#   0.0.0.0     모든 인터페이스 (기본)
#   127.0.0.1   이 서버에서만. 앞단에 별도 웹 서버를 둘 때 씁니다.
BIND_ADDRESS=0.0.0.0

# 설치 완료 안내에 표시할 주소. 비워 두면 서버의 첫 IP 를 씁니다.
ACCESS_HOST=

# 컨테이너 이름. 한 서버에 두 벌을 올릴 때만 바꾸세요.
CONTAINER_NAME=openstack-ops-platform

# ---------------------------------------------------------------------------
# 네트워크
# ---------------------------------------------------------------------------

# 이 플랫폼은 컨테이너 안에서 점검 대상 노드로 SSH 를 나갑니다.
# 기본(브리지 네트워크)으로 사설망에 닿지 않는다면 yes 로 바꾸세요.
# host 네트워크를 쓰면 HOST_PORT 설정은 무시되고 8090 으로 고정됩니다.
USE_HOST_NETWORK=no

# ---------------------------------------------------------------------------
# 시간대
# ---------------------------------------------------------------------------

# 예약 점검 시각과 로그 시각의 기준.
TIMEZONE=Asia/Seoul

# ---------------------------------------------------------------------------
# 관리자 계정
# ---------------------------------------------------------------------------

ADMIN_USERNAME=admin

# 비워 두면 기본 초기 비밀번호 Okestro2018@ 로 계정을 만들고,
# 첫 로그인에서 비밀번호 변경을 요구합니다. 이 방식을 권장합니다.
#
# 사이트 정책상 기본값을 쓸 수 없다면 여기에 초기 비밀번호를 넣으세요.
# 로그인한 뒤에는 반드시 이 값을 다시 비우고 ./opsctl.sh restart 하세요.
ADMIN_PASSWORD=

# 비밀번호를 잊었을 때만 씁니다.
#   1. ADMIN_PASSWORD 에 새 비밀번호를 넣습니다.
#   2. ADMIN_PASSWORD_RESET=1 로 바꿉니다.
#   3. ./opsctl.sh restart
#   4. 로그인한 뒤 두 값을 모두 비우고 다시 restart 합니다.
ADMIN_PASSWORD_RESET=

# 로그인 세션 유지 시간(시간 단위, 1~720).
SESSION_TTL_HOURS=8
